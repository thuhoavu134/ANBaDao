{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/oauth?orig=/api/auth/:path*" },
    { "source": "/battle", "destination": "/battle.html" },
    { "source": "/qa-dinh-loi-spacing", "destination": "/qa-dinh-loi-spacing.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
