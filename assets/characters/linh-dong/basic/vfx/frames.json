{
  "schema": "hon-viet-vfx-atlas/v1",
  "id": "linh-dong.basic.vfx",
  "atlas": "../../skill1_vfx-atlas.webp",
  "layout": {
    "type": "grid",
    "columns": 10,
    "rows": 12,
    "frameCount": 120,
    "cellWidth": 320,
    "cellHeight": 180
  },
  "timeline": {
    "durationMs": 4000,
    "loop": false,
    "playAllFrames": true
